{
  "version": 2,
  "builds": [
    { "src": "api/create-google-pay-order.js", "use": "@vercel/node" },
    { "src": "api/verify-payment.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "data.js", "use": "@vercel/static" },
    { "src": "diagram.js", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/" }
  ]
}
